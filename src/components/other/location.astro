---
import { Pin } from "@lucide/astro";
import { Badge } from "../ui/badge";
---

<div class="relative mb-20">
  <Badge
    className="text-md relative rotate-1 bg-olive-200 py-3 pl-4 text-olive-500"
    >Bakı, Azərbaycan</Badge
  >
  <span class="absolute -inset-5 -left-2 z-10">
    <Pin class="-rotate-14" data-icon="inline-start" fill="white" size={30} />
  </span>
  <div class="absolute inset-1 translate-x-0 translate-y-1 -skew-x-5">
    <hr class="absolute mb-3 w-3 -rotate-45 border-black/30" />
    <hr class="absolute w-3 rotate-45 border-black/30" />
  </div>
</div>
