---
import "../styles/global.css";
import { ArrowDown } from "@lucide/astro";
import Layout from "../layouts/layout.astro";
import { Button } from "@/components/ui/button";
import Location from "@/components/other/location.astro";
import { OtherLink } from "@/layouts/otherLinks/otherLinks";
import ProjectsCard from "@/components/other/projectsCard.astro";
import ProjectsTitle from "@/components/other/projectsTitle.astro";
import ExperienceSection from "@/components/other/experienceSection.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<!-- https://tailwindcss.com/docs/hover-focus-and-other-states#before-and-after --- Highlights effect --><!-- https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/hr --- hr tag style --><!-- https://stackblitz.com/edit/github-q2hjvn-2ow4sj?file=src%2Fpages%2Findex.astro & https://github.com/withastro/astro/issues/8835 Astro shadcn/ui library causes errors  -->
<Layout>
  <section>
    <div class="bg-[url(src/assets/ttten.svg)] bg-no-repeat">
      <div class="container mx-auto px-4">
        <div class="flex h-dvh w-full flex-col items-center justify-center">
          <Location />
          <article class="flex flex-col items-center pb-10">
            <h1 class="text-center text-5xl text-neutral-800">
              <b>
                Mən Nadir Yusifov,
                <span
                  class="text-line relative inline-block before:absolute before:-inset-1 before:block before:-skew-x-2 before:-skew-y-2 before:bg-olive-200"
                >
                  <span class="hero-title relative text-olive-500"
                    >Frontend Developer</span
                  >
                </span>
              </b>
            </h1>
          </article>
          <div class="flex gap-x-5">
            <a href="/public/NadirYusifovCV.pdf" download>
              <Button
                className="transtion-all cursor-pointer text-lg text-neutral-800 duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg"
                variant="outline"
                size="lg"
                type="button">CV-mi yüklə</Button
              >
            </a>
            <a href="mailto:nadiryusifov70@gmail.com">
              <Button
                className="transtion-all cursor-pointer text-lg text-neutral-800 duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg"
                variant="outline"
                size="lg"
                type="button">Maildən yaz</Button
              >
            </a>
          </div>
          <div class="mt-20">
            <ArrowDown class="animate-bounce text-olive-500" />
          </div>
        </div>

        <div id="projects" class="mb-50 h-dvh scroll-mt-40">
          <article class="pb-10">
            <ProjectsTitle projects="Layihələr" />
          </article>
          <ProjectsCard />
        </div>

        <div id="experience" class="mb-50 scroll-mt-40">
          <ExperienceSection />
        </div>
      </div>
    </div>
  </section>
  <OtherLink client:visible />
</Layout>

<!-- https://gsap.com/community/forums/topic/39684-gsap-astro/ -- GSAP + Astro use -->

<script>
  import { gsap } from "gsap";
  import { SplitText } from "gsap/dist/SplitText";

  let split = SplitText.create(".hero-title", {
    type: "words",
    linesClass: "line++",
    autoSplit: true,
  });
  gsap.from(split.words, {
    y: -15,
    opacity: 0,
    duration: 0.8,
    ease: "power2.out",
    stagger: 0.5,
    autoAlpha: 0,
  });
</script>
