---
import "../styles/global.css";
import { ArrowDown } from "@lucide/astro";
import Layout from "../layouts/layout.astro";
import { Button } from "@/components/ui/button";
import Location from "@/components/other/location.astro";
import { OtherLink } from "@/layouts/otherLinks/otherLinks";
import ProjectsCard from "@/components/other/projectsCard.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<!-- https://tailwindcss.com/docs/hover-focus-and-other-states#before-and-after --- Highlights effect --><!-- https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/hr --- hr tag style --><!-- https://stackblitz.com/edit/github-q2hjvn-2ow4sj?file=src%2Fpages%2Findex.astro & https://github.com/withastro/astro/issues/8835 Astro shadcn/ui library causes errors  -->
<Layout>
  <section>
    <div class="bg-[url(src/assets/ttten.svg)] bg-no-repeat">
      <div class="container mx-auto px-4">
        <div class="flex h-dvh w-full flex-col items-center justify-center">
          <Location />
          <article class="mb-10 flex flex-col items-center">
            <h1 class="text-center text-5xl">
              <b>
                Mən Nadir Yusifov,
                <span
                  class="relative inline-block before:absolute before:-inset-1 before:block before:-skew-x-2 before:-skew-y-2 before:bg-olive-200"
                >
                  <span class="relative text-olive-500">Frontend Developer</span
                  >
                </span>
              </b>
            </h1>
          </article>
          <div class="flex gap-x-5">
            <a href="/NadirYusifov.pdf" download>
              <Button
                className="transtion-all cursor-pointer text-lg duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg"
                variant="outline"
                size="lg"
                type="button">CV-mi yüklə</Button
              >
            </a>
            <a href="mailto:nadiryusifov70@gmail.com">
              <Button
                className="transtion-all cursor-pointer text-lg duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg"
                variant="outline"
                size="lg"
                type="button">Maildən yaz</Button
              >
            </a>
          </div>
          <div class="mt-20">
            <ArrowDown class="animate-bounce text-olive-500" />
          </div>
        </div>

        <div id="projects" class="mb-50 h-dvh scroll-mt-40">
          <article class="pb-5">
            <h2 class="text-3xl">Layihələr</h2>
          </article>
          <ProjectsCard />
        </div>

        <div id="experience" class="mb-50 scroll-mt-40">
          <article class="pb-5">
            <h2 class="text-3xl">İş təcrübəm</h2>
          </article>
          <div class="gap-x-10">
            <ul
              class="experience-list list-outside space-y-5 px-4 marker:bg-olive-500 marker:text-olive-500"
            >
              <li class="transition-all ease-in-out hover:translate-x-1">
                <a href="#" class="text-2xl font-medium">Food2</a>
                <p class="text-lg">
                  Food2 layihəsində Partnership səhifəsinə və tərcümə hisssəsini
                  hazırladım.
                </p>
                <span class="text-[1rem] text-olive-500"
                  >Noyabr 2025 ‒ Davam edir</span
                >
              </li>
              <li class="transition-all ease-in-out hover:translate-x-1">
                <a href="#" class="pb-20 text-2xl font-medium">Karyera Z</a>
                <p class="text-lg">Frontend Developer olaraq çalışmışam.</p>
                <span class="text-[1rem] text-olive-500"
                  >Sentyabr 2024 ‒ Dekabr 2024</span
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
  <OtherLink client:visible />
</Layout>
