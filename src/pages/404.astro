---
import { Button } from "@/components/ui/button";
import Layout from "@/layouts/layout.astro";
---

<Layout>
  <section>
    <div class="conatiner mx-auto px-4">
      <div class="flex flex-col h-dvh w-full items-center justify-center">
        <article class="flex items-center">
          <p class="-rotate-3 text-[7.5rem] text-olive-500">4</p>
          <p class="rotate-12 text-[7.5rem] text-olive-500">0</p>
          <p class="-rotate-6 text-[7.5rem] text-olive-500">4</p>
        </article>
        <artcile>
          <h1 class="text-xl font-medium ">Axtardığını tapa bilmədin.</h1>
        </artcile>
        <div class="mt-3">
            <a href="/">
                <Button
                  className="transtion-all cursor-pointer text-lg duration-200 ease-in-out hover:-translate-y-1 hover:shadow-lg"
                  variant="outline"
                  size="lg"
                  type="button">Əsas səhifəyə qayıt</Button
                >
            </a>
        </div>
      </div>
    </div>
