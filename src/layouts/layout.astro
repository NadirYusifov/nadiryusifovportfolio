---
import Footer from "./footer/footer.astro";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Nadir Yusifov</title>
  </head>
  <body class="scroll-pt-20">
    <nav
      class="border-border sticky top-3 z-20 mx-auto mt-3 flex w-[90%] items-center justify-center space-x-10 border bg-white py-4 text-center lg:w-2/5"
    >
      <a
        class="translate-y-0 text-neutral-800 transition-all duration-100 ease-in-out hover:text-olive-500 hover:text-shadow-lg active:scale-95"
        href="/">Əsas səhifə</a
      >
      <a
        class="translate-y-0 text-neutral-800 transition-all duration-100 ease-in-out hover:text-olive-500 hover:text-shadow-lg active:scale-95"
        href="/projects">Layihələr</a
      >
    </nav>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

