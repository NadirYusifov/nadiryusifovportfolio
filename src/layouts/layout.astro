---
import { Image } from "astro:assets";
import NYLogo from "../assets/logo.png";
import Footer from "./footer/footer.astro";
---

<!-- Ortadakı elementi tən ortada saxlamaq üçün AI istifadə etdim.
Kod: absolute left-1/2 -transalte-x-1/2
-->
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Nadir Yusifov</title>
  </head>
  <body class="scroll-pt-20">
    <header
      class="border-border sticky top-3 z-20 mx-auto mt-3 flex w-[90%] items-center border bg-white py-4 lg:w-2/5"
    >
      <picture
        class="pl-5 transition-all duration-100 ease-in-out active:scale-95"
      >
        <a href="/">
          <Image
            src={NYLogo}
            width={35}
            height={35}
            quality={100}
            alt="NY logo"
            class="border-border border"
          />
        </a>
      </picture>
      <nav class="block lg:flex absolute left-1/2 -translate-x-1/2 space-x-0 lg:space-x-4 text-center">
        <a
          class="block translate-y-0 text-neutral-800 transition-all duration-100 ease-in-out hover:text-olive-500 hover:text-shadow-lg active:scale-95"
          href="/">Əsas səhifə</a
        >
        <a
          class="translate-y-0 text-neutral-800 transition-all duration-100 ease-in-out hover:text-olive-500 hover:text-shadow-lg active:scale-95"
          href="/projects">Layihələr</a
        >
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
