---
import "../../styles/global.css";
import { getCollection } from "astro:content";

const collection = await getCollection("socialMediaLinks");
---

<!-- https://www.ionos.com/digitalguide/websites/web-development/html-unordered-lists/ for ul list
https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/ul

-->
<footer class="mt-60 mb-5">
  <div class="mx-4 h-87.5 bg-olive-200 py-20 lg:mx-50">
    <div class="container mx-auto px-4">
      <article class="flex justify-center gap-x-10">
        <ul>
          <li class="text-lg text-neutral-800 underline underline-offset-4">
            Sosial hesaplar
          </li>
          <ul class="pt-2">
            {
              collection.map((item) => (
                <li class="transition-all duration-200 ease-in-out hover:pl-1">
                  <a class="text-neutral-800" href={item.data.link}>
                    {item.data.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </ul>

        <!-- <ul>
          <li class="text-lg text-neutral-800 underline underline-offset-4">
            Başqa keçidlər
          </li>
          <ul class="pt-2">
            <li class="transition-all duration-200 ease-in-out hover:pl-1">
              <a class="text-neutral-800" href="/referances">Referanslar</a>
            </li>
          </ul>
        </ul> -->
      </article>
    </div>
  </div>
  <article class="mt-3 text-center">
    <p class="text-neutral-700">
      Hazırladı <a
        class="text-olive-500 underline"
        href="https://github.com/NadirYusifov">NadirYusifov</a
      >
    </p>
  </article>
</footer>
